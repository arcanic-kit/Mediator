<Project>

  <!-- Language and Framework -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Build Configuration -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701;CS0168;CS1574</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Common Assembly / Package Information -->
  <PropertyGroup>
    <!-- Default for local builds; the release workflow overrides it with the tag version (-p:Version=...).
         First segment = .NET major version, second = major library update, third = minor update or patch. -->
    <Version>11.0.0</Version>

    <Authors>Intello Solutions</Authors>
    <Company>Intello Solutions</Company>
    <Copyright>Intello Solutions 2025</Copyright>

    <!-- Repository Information -->
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/arcanic-kit/mediator</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/arcanic-kit/mediator</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/arcanic-kit/mediator/releases</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

</Project>
